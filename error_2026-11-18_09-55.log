    formData[key] = value;\n        }\n\n        if (this.value) {\n            formData.submitId = this.value;\n        } else {\n            formData.submitId = \'cancel\';\n        }\n        xhr.send(JSON.stringify(formData));\n\n        // Modified logic for ok (cancel) button\n        if(cancel_button) {\n            handleSubmissionComplete();\n        }\n    }\n\n    function handleSubmissionComplete() {\n        // 1. Disable all submit buttons and make them grey\n        for (var j=0; j<justifySubmitBtns.length; j++) {\n            justifySubmitBtns[j].setAttribute(\'disabled\', \'disabled\');\n            justifySubmitBtns[j].style.background = \'#EEEEEE\';\n            justifySubmitBtns[j].style.borderColor = \'#E3E3E3\';\n            justifySubmitBtns[j].style.color = \'#ccc\';\n        }\n\n        // 2. Disable the Text Box and make it grey\n        var textBox = doc.querySelector(\'#ns-justify-description-box\');\n        if(textBox) {\n            textBox.setAttribute(\'disabled\', \'disabled\');\n            textBox.style.backgroundColor = \'#EEEEEE\';\n            textBox.style.borderColor = \'#E3E3E3\';\n            textBox.style.color = \'#ccc\';\n        }\n\n        // 3. Disable any other submit buttons found\n        var proceedBtn = doc.querySelector(\'#ns-justify-submit\');\n        if(proceedBtn) {\n            proceedBtn.setAttribute(\'disabled\', \'disabled\');\n        }\n\n        // 4. Disable radio buttons\n        if(justifyRadio) {\n            justifyRadio.setAttribute(\'disabled\', \'disabled\');\n        }\n        if(falsePositiveRadio) {\n            falsePositiveRadio.setAttribute(\'disabled\', \'disabled\');\n        }\n\n        // 5. Show the message only if referrer is \'/\'\n        var referrer = "/";\n        if (referrer == "/") {\n            var btnGroup = doc.querySelector(\'.ns-btn-group\');\n            if (btnGroup) {\n                // Check if message already exists to prevent duplicate insertion\n                if (!doc.querySelector(\'.ns-success-msg\')) {\n                    var msgSpan = doc.createElement(\'div\');\n                    msgSpan.className = \'ns-success-msg\';\n\n                    var currentLang = language.indexOf("NS_LANGUAGE") > -1 ? \'en\' : language;\n                    var langData = ackMessages[currentLang] || ackMessages[\'en\'];\n\n                    // Visibility detection for UI elements to determine appropriate message\n                    // Check if description box is present and visible in DOM:\n                    // - Element exists (descriptionFieldBox)\n                    // - Element is rendered in layout (offsetParent !== null)\n                    // - Element is not explicitly hidden (computed display !== \'none\')\n                    var hasDescriptionBox = Boolean(\n                        descriptionFieldBox &&\n                        descriptionFieldBox.offsetParent !== null &&\n                        window.getComputedStyle(descriptionFieldBox).display !== \'none\'\n                    );\n                    \n                    // Check if either justification radio button is present and visible in DOM:\n                    // - justifyRadio exists and is rendered (offsetParent !== null)\n                    // - OR falsePositiveRadio exists and is rendered (offsetParent !== null)\n                    var hasRadioButtons = Boolean((justifyRadio && justifyRadio.offsetParent !== null) ||\n                                                   (falsePositiveRadio && falsePositiveRadio.offsetParent !== null));\n                    \n                    var message = (hasDescriptionBox || hasRadioButtons) ? langData.justification_message : langData.block_message;\n\n                    msgSpan.innerHTML = message;\n                    btnGroup.appendChild(msgSpan);\n                }\n            }\n        }\n    }\n\n    validateForm();\n    // add events\n    if (descriptionField) {\n        descriptionField.addEven