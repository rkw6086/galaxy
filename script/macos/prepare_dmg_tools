#!/bin/bash
# Provision the headless disk-image tools before signing credentials are loaded.
set -euo pipefail
[[ $# == 1 && $1 == /* && ! -e $1 && ! -L $1 ]] || {
  echo 'Usage: prepare_dmg_tools /absolute/fresh/tool-directory' >&2; exit 1;
}
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
python3 -c 'import sys; assert sys.version_info >= (3, 10), "DMG packaging requires Python 3.10 or newer"'
python3 -m venv "$1"
"$1/bin/python3" -m pip install --disable-pip-version-check --only-binary=:all: --require-hashes -r "$root/script/macos/dmg/requirements.txt"
