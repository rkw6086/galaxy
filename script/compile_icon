#!/bin/bash
#
# Compile the Galaxy icon with the selected Xcode's supported format.
# Xcode 26 and later use the adaptive .icon bundle; earlier versions use ICNS.
#
# Usage: compile_icon oss <app_bundle_path>
#   app_bundle_path: Path to the Galaxy.app bundle

set -euo pipefail

if [[ "$#" -ne 2 ]]; then
    echo "Usage: compile_icon oss <app_bundle_path>" >&2
    exit 1
fi

CHANNEL="$1"
APP_BUNDLE_PATH="$2"

if [[ "$CHANNEL" != "oss" ]]; then
    echo "Error: only the oss release channel is supported" >&2
    exit 1
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ICON_BUNDLE_PATH="$REPO_ROOT/app/channels/$CHANNEL/icon/AppIcon.icon"
SOURCE_ICON="$REPO_ROOT/app/assets/bundled/png/galaxy.png"
BUNDLED_RESOURCES_DIR="$APP_BUNDLE_PATH/Contents/Resources"
INFO_PLIST="$APP_BUNDLE_PATH/Contents/Info.plist"

[[ -d "$ICON_BUNDLE_PATH" && -f "$SOURCE_ICON" ]] || {
    echo "Error: Galaxy icon sources are missing" >&2
    exit 1
}
[[ -d "$BUNDLED_RESOURCES_DIR" && -f "$INFO_PLIST" ]] || {
    echo "Error: app bundle resources or Info.plist are missing" >&2
    exit 1
}

XCODE_VERSION=$(xcodebuild -version)
if [[ "$XCODE_VERSION" =~ ^Xcode[[:space:]]+([0-9]+) ]]; then
    XCODE_MAJOR="${BASH_REMATCH[1]}"
else
    echo "Error: cannot determine the selected Xcode version" >&2
    exit 1
fi

TEMP_ICON_ROOT="$(mktemp -d)"
trap 'rm -rf "$TEMP_ICON_ROOT"' EXIT

if (( XCODE_MAJOR < 26 )); then
    # Older actool versions do not understand .icon packages. Build the legacy
    # icon directly from the same artwork instead of referencing missing assets.
    echo "Compiling Galaxy ICNS icon for Xcode $XCODE_MAJOR"
    ICONSET_PATH="$TEMP_ICON_ROOT/AppIcon.iconset"
    mkdir "$ICONSET_PATH"
    for size in 16 32 128 256 512; do
        sips -z "$size" "$size" "$SOURCE_ICON" \
            --out "$ICONSET_PATH/icon_${size}x${size}.png" >/dev/null
        retina_size=$((size * 2))
        if (( retina_size == 1024 )); then
            cp "$SOURCE_ICON" "$ICONSET_PATH/icon_${size}x${size}@2x.png"
        else
            sips -z "$retina_size" "$retina_size" "$SOURCE_ICON" \
                --out "$ICONSET_PATH/icon_${size}x${size}@2x.png" >/dev/null
        fi
    done
    iconutil -c icns -o "$TEMP_ICON_ROOT/AppIcon.icns" "$ICONSET_PATH"
    [[ -s "$TEMP_ICON_ROOT/AppIcon.icns" ]] || {
        echo "Error: iconutil did not produce a Galaxy ICNS icon" >&2
        exit 1
    }
    cp "$TEMP_ICON_ROOT/AppIcon.icns" "$BUNDLED_RESOURCES_DIR/AppIcon.icns"
    plutil -replace CFBundleIconFile -string "AppIcon.icns" "$INFO_PLIST"
    if plutil -extract CFBundleIconName raw -o - "$INFO_PLIST" >/dev/null 2>&1; then
        plutil -remove CFBundleIconName "$INFO_PLIST"
    fi
    echo "Galaxy ICNS icon compiled successfully."
    exit 0
fi

# Stage adaptive assets separately, so a stale Assets.car from an incremental
# bundle cannot make an incomplete compilation look successful.
ACTOOL_ICON_BUNDLE_PATH="$TEMP_ICON_ROOT/AppIcon.icon"
COMPILED_RESOURCES_DIR="$TEMP_ICON_ROOT/compiled"
mkdir -p "$ACTOOL_ICON_BUNDLE_PATH/Assets" "$COMPILED_RESOURCES_DIR"
cp "$ICON_BUNDLE_PATH/icon.json" "$ACTOOL_ICON_BUNDLE_PATH/icon.json"
cp "$SOURCE_ICON" "$ACTOOL_ICON_BUNDLE_PATH/Assets/Galaxy.png"

echo "Compiling Galaxy adaptive icon for Xcode $XCODE_MAJOR"
xcrun actool \
    --compile "$COMPILED_RESOURCES_DIR" \
    --platform macosx \
    --minimum-deployment-target 10.14 \
    --app-icon AppIcon \
    --output-partial-info-plist "$TEMP_ICON_ROOT/partial-icon-info.plist" \
    "$ACTOOL_ICON_BUNDLE_PATH"

[[ -s "$COMPILED_RESOURCES_DIR/Assets.car" ]] || {
    echo "Error: actool did not produce the required adaptive icon Assets.car" >&2
    exit 1
}
cp -R "$COMPILED_RESOURCES_DIR/." "$BUNDLED_RESOURCES_DIR/"
plutil -replace CFBundleIconFile -string "AppIcon" "$INFO_PLIST"
plutil -insert CFBundleIconName -string "AppIcon" "$INFO_PLIST" 2>/dev/null || \
    plutil -replace CFBundleIconName -string "AppIcon" "$INFO_PLIST"

echo "Galaxy adaptive icon compiled successfully."
